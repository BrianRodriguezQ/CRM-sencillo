# ─── Configuración — NAME@EMP Delivery CRM ─────────────────────────────
# PGlite (dev, sin servidor): NO definas DATABASE_URL → usa ./.pglite
# Producción: definí DATABASE_URL (Postgres) y el schema/migraciones son idénticos.
# DATABASE_URL=postgres://user:pass@localhost:5432/nameemp
JWT_SECRET=cambiar-este-secreto-en-produccion
PORT=3001
NODE_ENV=development

# PGlite (opcional — dónde guardar los datos embebidos, default: ./.pglite)
# PGLITE_DATA_DIR=./.pglite

# Nombre del negocio que aparece en el encabezado/pie de los PDF (notas de entrega)
BUSINESS_NAME=NAME@EMP
